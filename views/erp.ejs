<%- include('partials/head') %>
<h1 class="page-title">ERP Items</h1>
<p class="page-sub">Zoho ERP items for <%= info.organization %>. Taken <%= info.takenAt %>. This is the one-time copy. Later edits will arrive by webhook.</p>
<% if (!ready) { %>
  <div class="banner err"><%= loadError || "The ERP items are not loaded yet." %></div>
<% } else { %>
  <form id="erp-search" data-catalog="/erp-items" data-prefix="erp" method="get" action="/erp-items" class="filters">
    <div class="suggest-wrap grow">
      <input id="erp-q" name="q" value="<%= q %>" placeholder="Search name, SKU, part number, group, or description" autocomplete="off" autofocus>
      <div id="erp-suggest" class="suggest" hidden></div>
    </div>
    <select name="status" id="erp-status">
      <option value="all" <%= status === 'all' ? 'selected' : '' %>>All (<%= counts.total %>)</option>
      <option value="active" <%= status === 'active' ? 'selected' : '' %>>Active (<%= counts.active %>)</option>
      <option value="inactive" <%= status === 'inactive' ? 'selected' : '' %>>Inactive (<%= counts.inactive %>)</option>
    </select>
    <button type="submit">Search</button>
  </form>
  <p class="muted" id="erp-count">Showing <%= rows.length ? ((current - 1) * pageSize + 1) + '–' + ((current - 1) * pageSize + rows.length) : '0' %> of <%= total %><% if (q) { %> for “<%= q %>”<% } %></p>
  <div class="books-table-wrap">
    <table class="books-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>SKU</th>
          <th>Part #</th>
          <th>Selling price</th>
          <th>Unit</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody id="erp-rows">
        <% if (!rows.length) { %>
          <tr><td colspan="6">No items match this search.</td></tr>
        <% } %>
        <% rows.forEach((row) => { %>
          <tr>
            <td><a href="/erp-items/<%= row.item_id %>"><%= row.name %></a></td>
            <td><%= row.sku || "—" %></td>
            <td><%= row.part_number || "—" %></td>
            <td><%= money(row.rate) %></td>
            <td><%= row.unit || "—" %></td>
            <td class="<%= row.status === 'inactive' ? 'muted' : '' %>"><%= row.status || "—" %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="tools" id="erp-pager" style="margin-top:14px">
    <% if (current > 1) { %>
      <a class="btn" href="/erp-items?q=<%= encodeURIComponent(q) %>&status=<%= status %>&page=<%= current - 1 %>">Previous</a>
    <% } %>
    <span class="muted">Page <%= current %> of <%= pages %></span>
    <% if (current < pages) { %>
      <a class="btn" href="/erp-items?q=<%= encodeURIComponent(q) %>&status=<%= status %>&page=<%= current + 1 %>">Next</a>
    <% } %>
  </div>
<% } %>
<%- include('partials/foot') %>
